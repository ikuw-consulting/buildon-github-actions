#
# prepare-substitution-tokens - Prepares token files for substitution
#
# Writes built-in tokens from environment variables and copies user config tokens.
# Used by kubernetes-manifests-package and docker-build-dockerfile.
#
# Inputs (environment variables):
#   TOKENS_OUTPUT_SUB_PATH - Where to write token files (required)
#   CONFIG_SUB_PATH        - User config directory (default: src/config)
#   TOKEN_NAME_STYLE       - Case style for token names (default: PascalCase)
#   TOKEN_NAME_VALIDATION  - How to validate user token names (default: MATCH)
#   TOKEN_BUILTIN_MODE     - standard or template (default: standard)
#   CONFIG_VALUE_TRAILING_NEWLINE - Trailing newline handling (default: strip-for-single-line)
#
# Built-in tokens (read from env, written if set):
#   PROJECT_NAME, VERSION, DOCKER_TAG, DOCKER_IMAGE_NAME, GIT_TAG
#   VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH
#   VERSION_2_PART, VERSION_3_PART, VERSION_4_PART
#   VERSION_DNS_SAFE, VERSION_2_PART_DNS_SAFE, VERSION_3_PART_DNS_SAFE, VERSION_4_PART_DNS_SAFE
#   TARGET_REGISTRY, TARGET_NAMESPACE, IS_RELEASE
#   DOCKER_IMAGE_FULL_URI, MANIFESTS_ZIP_FILE_NAME
#
# Context scalars (REPOSITORY_*, PRODUCT_*, GIT_*, etc) are NOT read from env;
# they arrive via the builtin-resolved-tokens/ disk scan, written once by the
# step that owns them (versions-and-naming, kubernetes-product-aggregate, ...).
#
set -euo pipefail

# Locate script directory for finding plugins and libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"
PLUGINS_DIR="${SCRIPT_DIR}/../plugins"

# shellcheck source=src/scripts/defaults/platform.bash
source "${SCRIPT_DIR}/../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "${SCRIPT_DIR}/../lib/log.bash"
# shellcheck source=src/scripts/defaults/output-sub-path.bash
source "${SCRIPT_DIR}/../defaults/output-sub-path.bash"

# shellcheck disable=SC1091 # path not resolvable at static analysis time
# Source the token formatting library
source "${LIB_DIR}/token-format.bash"

# Required inputs
TOKENS_OUTPUT_SUB_PATH="${TOKENS_OUTPUT_SUB_PATH:?TOKENS_OUTPUT_SUB_PATH is required}"

# Optional inputs with defaults
# shellcheck source=src/scripts/defaults/tokens.bash
source "${SCRIPT_DIR}/../defaults/tokens.bash"

# Validate token name style upfront
if ! is_valid_token_name_style "${TOKEN_NAME_STYLE}"; then
  log_error "Unknown token name style: ${TOKEN_NAME_STYLE}"
  exit 1
fi

# Canonical prefix the template mode publishes this build's own values under,
# leaving the plain names deferred to the consuming build.
readonly TEMPLATE_MODE_PREFIX="ORIGINAL"

# Validate builtin mode upfront - a typo must not silently behave as standard
case "${TOKEN_BUILTIN_MODE}" in
  standard|template) ;;
  *)
    log_error "Unknown builtin token mode: ${TOKEN_BUILTIN_MODE} (expected standard or template)"
    exit 1
    ;;
esac

# Required built-in tokens (must be set by caller - provided by versions-and-naming)
PROJECT_NAME="${PROJECT_NAME:?PROJECT_NAME is required}"
VERSION="${VERSION:?VERSION is required}"
VERSION_MAJOR="${VERSION_MAJOR:?VERSION_MAJOR is required}"
VERSION_MINOR="${VERSION_MINOR:?VERSION_MINOR is required}"
VERSION_PATCH="${VERSION_PATCH:?VERSION_PATCH is required}"
VERSION_2_PART="${VERSION_2_PART:?VERSION_2_PART is required}"
VERSION_3_PART="${VERSION_3_PART:?VERSION_3_PART is required}"
VERSION_4_PART="${VERSION_4_PART:?VERSION_4_PART is required}"
VERSION_DNS_SAFE="${VERSION_DNS_SAFE:?VERSION_DNS_SAFE is required}"
VERSION_2_PART_DNS_SAFE="${VERSION_2_PART_DNS_SAFE:?VERSION_2_PART_DNS_SAFE is required}"
VERSION_3_PART_DNS_SAFE="${VERSION_3_PART_DNS_SAFE:?VERSION_3_PART_DNS_SAFE is required}"
VERSION_4_PART_DNS_SAFE="${VERSION_4_PART_DNS_SAFE:?VERSION_4_PART_DNS_SAFE is required}"
GIT_TAG="${GIT_TAG:?GIT_TAG is required}"
IS_RELEASE="${IS_RELEASE:?IS_RELEASE is required}"
DOCKER_TAG="${DOCKER_TAG:?DOCKER_TAG is required}"
DOCKER_IMAGE_NAME="${DOCKER_IMAGE_NAME:?DOCKER_IMAGE_NAME is required}"

# Write a built-in token file. Under template mode the canonical name is
# prefixed before conversion, so the plain name is left unresolved in the
# manifests for the consuming build to supply.
write_builtin_token() {
  local name="$1"
  local value="$2"
  local target_name

  if [[ "${TOKEN_BUILTIN_MODE}" == "template" ]]; then
    name="${TEMPLATE_MODE_PREFIX}_${name}"
  fi
  target_name=$(convert_token_name "${TOKEN_NAME_STYLE}" "${name}")

  printf '%s' "${value}" > "${TOKENS_OUTPUT_SUB_PATH}/${target_name}"
}

# Scan the auto-emitted builtin token dirs and copy each file verbatim into
# TOKENS_OUTPUT_SUB_PATH. Filenames are already in the consumer's
# TOKEN_NAME_STYLE on disk (lib/builtin-tokens-from-entry.bash writes them that
# way), so no name conversion is needed here.
#
# Source dirs are produced by lib/builtin-tokens-from-entry.bash via
# content-resolve.bash, kaptain-init, versions-and-naming and
# kubernetes-product-aggregate. Each dir has a required filename
# prefix derived from the subdir (e.g. contents -> Content, BUILD -> Build);
# files not matching their dir's prefix are a hard failure (catches malformed
# bundles or future writers that skip the emitter).
#
# Missing dirs are silently skipped (the resolver may run before this, or not
# at all for this build kind).
scan_auto_builtin_tokens() {
  local base_dir="${OUTPUT_SUB_PATH}/builtin-resolved-tokens"
  if [[ ! -d "${base_dir}" ]]; then
    return 0
  fi

  local flavour upper_prefix expected_prefix dir file name
  for flavour in contents templates layers build image git kaptainpm repository product environment; do
    dir="${base_dir}/${flavour}"
    [[ ! -d "${dir}" ]] && continue

    # contents -> CONTENT, templates -> TEMPLATE, layers -> LAYER,
    # build/image/git/kaptainpm/repository/product/environment -> unchanged (no 's').
    upper_prefix=$(printf '%s' "${flavour%s}" | tr '[:lower:]' '[:upper:]')
    expected_prefix=$(convert_token_name "${TOKEN_NAME_STYLE}" "${upper_prefix}")

    while IFS= read -r -d '' file; do
      name=$(basename "${file}")
      if [[ "${name}" != "${expected_prefix}"* ]]; then
        log_error "Auto-emitted token '${name}' in ${dir} does not start with required prefix '${expected_prefix}'"
        exit 1
      fi
      # Prefix check runs against the on-disk name, so template mode renames
      # only on the way out - these defer like every other built-in.
      if [[ "${TOKEN_BUILTIN_MODE}" == "template" ]]; then
        name=$(prefix_token_name "${TOKEN_NAME_STYLE}" "${TEMPLATE_MODE_PREFIX}" "${name}")
      fi
      cp "${file}" "${TOKENS_OUTPUT_SUB_PATH}/${name}"
    done < <(find "${dir}" -type f -print0)
  done
}

main() {
  log "Preparing substitution tokens..."
  log "  Output: ${TOKENS_OUTPUT_SUB_PATH}"
  log "  Config: ${CONFIG_SUB_PATH}"
  log "  Name style: ${TOKEN_NAME_STYLE}"
  log "  Validation: ${TOKEN_NAME_VALIDATION}"
  log "  Builtin mode: ${TOKEN_BUILTIN_MODE}"

  # Create output directory
  mkdir -p "${TOKENS_OUTPUT_SUB_PATH}"

  # Step 1: Write built-in tokens from environment variables
  log "Writing built-in tokens..."

  # Required tokens provided by versions-and-naming which always precedes this)
  write_builtin_token "PROJECT_NAME" "${PROJECT_NAME}"
  write_builtin_token "VERSION" "${VERSION}"
  write_builtin_token "VERSION_MAJOR" "${VERSION_MAJOR}"
  write_builtin_token "VERSION_MINOR" "${VERSION_MINOR}"
  write_builtin_token "VERSION_PATCH" "${VERSION_PATCH}"
  write_builtin_token "VERSION_2_PART" "${VERSION_2_PART}"
  write_builtin_token "VERSION_3_PART" "${VERSION_3_PART}"
  write_builtin_token "VERSION_4_PART" "${VERSION_4_PART}"
  write_builtin_token "VERSION_DNS_SAFE" "${VERSION_DNS_SAFE}"
  write_builtin_token "VERSION_2_PART_DNS_SAFE" "${VERSION_2_PART_DNS_SAFE}"
  write_builtin_token "VERSION_3_PART_DNS_SAFE" "${VERSION_3_PART_DNS_SAFE}"
  write_builtin_token "VERSION_4_PART_DNS_SAFE" "${VERSION_4_PART_DNS_SAFE}"
  write_builtin_token "GIT_TAG" "${GIT_TAG}"
  write_builtin_token "IS_RELEASE" "${IS_RELEASE}"
  write_builtin_token "DOCKER_TAG" "${DOCKER_TAG}"
  write_builtin_token "DOCKER_IMAGE_NAME" "${DOCKER_IMAGE_NAME}"
  # Note, the 2 docker specific ones are always generated regardless

  # Optional dockerfile build tokens (not available in kubernetes-app-manifests-only)
  if [[ -n "${DOCKER_IMAGE_FULL_URI:-}" ]]; then
    write_builtin_token "DOCKER_IMAGE_FULL_URI" "${DOCKER_IMAGE_FULL_URI}"
  fi
  if [[ -n "${TARGET_REGISTRY:-}" ]]; then
    write_builtin_token "TARGET_REGISTRY" "${TARGET_REGISTRY}"
  fi
  # Always written, possibly empty: targetIncludeNamespace=false resolves to
  # an empty namespace, and ${TargetNamespace} must substitute to "" rather
  # than ship as a dangling token.
  write_builtin_token "TARGET_NAMESPACE" "${TARGET_NAMESPACE:-}"

  # Optional platform tokens (available when called from docker-build-dockerfile)
  if [[ -n "${DOCKER_PLATFORM:-}" ]]; then
    write_builtin_token "DOCKER_PLATFORM" "${DOCKER_PLATFORM}"
  fi
  if [[ -n "${DOCKER_PLATFORM_CPU_ARCHITECTURE:-}" ]]; then
    write_builtin_token "DOCKER_PLATFORM_CPU_ARCHITECTURE" "${DOCKER_PLATFORM_CPU_ARCHITECTURE}"
  fi

  # Optional manifest packaging tokens (not available in docker-build-dockerfile)
  if [[ -n "${MANIFESTS_ZIP_FILE_NAME:-}" ]]; then
    write_builtin_token "MANIFESTS_ZIP_FILE_NAME" "${MANIFESTS_ZIP_FILE_NAME}"
  fi

  # Auto-emitted builtins: per-entry (contents/templates/layers) plus context
  # scalars (repository/product/environment/git/etc). Delivered via the on-disk
  # scan, NOT per-step env - env plumbing has to be repeated at every call site
  # and a missed site fails silently (tokens ship unsubstituted); files written
  # once by their owning step reach every context identically, local and remote.
  # Product and Environment tokens are emitted this way too (by
  # kubernetes-product-aggregate and kubernetes-run-substitute respectively).
  # Treated as built-ins for the override conflict check below: user config
  # that tries to redefine them fails the build.
  scan_auto_builtin_tokens

  # Step 2: Validate and copy user config if it exists
  if [[ -d "${CONFIG_SUB_PATH}" ]] && [[ -n "$(find "${CONFIG_SUB_PATH}" -type f 2>/dev/null)" ]]; then
    log "Validating user config tokens..."

    # Determine which validator to use
    local validator_style
    if [[ "${TOKEN_NAME_VALIDATION}" == "MATCH" ]]; then
      validator_style="${TOKEN_NAME_STYLE}"
    else
      validator_style="ALL"
    fi

    local validator_script="${PLUGINS_DIR}/token-name-validators/${validator_style}"

    if [[ ! -x "${validator_script}" ]]; then
      log_error "Validator not found: ${validator_style}"
      exit 1
    fi

    # Run validator
    if ! "${validator_script}" "${CONFIG_SUB_PATH}"; then
      exit 1
    fi

    # Step 3: Check for conflicts with built-in tokens
    local conflicts=()

    while IFS= read -r -d '' user_file; do
      local user_token="${user_file#"${CONFIG_SUB_PATH}"/}"
      # Check if this token name matches any built-in
      if [[ -f "${TOKENS_OUTPUT_SUB_PATH}/${user_token}" ]]; then
        conflicts+=("${user_token}")
      fi
    done < <(find "${CONFIG_SUB_PATH}" -type f -print0)

    if [[ ${#conflicts[@]} -gt 0 ]]; then
      log_error "Found attempt to override built-in variable(s) - this is not allowed:"
      for conflict in "${conflicts[@]}"; do
        log "  ${conflict}"
      done
      exit 1
    fi

    # Step 4: Copy user config to output
    log "Copying user config tokens..."
    cp -R "${CONFIG_SUB_PATH}"/* "${TOKENS_OUTPUT_SUB_PATH}/"
  fi

  log "Token preparation complete"
}

main "$@"
