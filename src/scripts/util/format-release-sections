#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Kaptain contributors (Fred Cooke)
#
# format-release-sections - Shared GitHub release-notes section formatter
#
# One formatter for every flavour's release notes so consumption instructions
# and what's-inside lists render identically everywhere. Callers compose the
# body: intro sentence, then 'consume', then zero or more 'list' calls
# (templates/contents today; environments/rps later need no changes here),
# then their Release Assets section.
#
# Usage:
#   format-release-sections consume <project-name> <version> <registry> <namespace> [forms]
#     Emits the "How to Consume" section. Each reference gets a fenced block of
#     its own so the URI never competes for width with prose and is trivial to
#     copy. [forms] carries spec.platform.githubActions.release
#     .consumerReferenceForms and selects which references appear, in which
#     order:
#       short-only  org-local reference alone (default, in-house work)
#       short-first both, org-local reference first
#       full-first  both, fully qualified reference first (open source)
#       full-only   fully qualified reference alone (vendor packages)
#     The two-form modes label each block; the single-form modes emit the one
#     block bare, since there is nothing to contrast it with.
#
#   format-release-sections list <heading> <list-file>
#     Emits "### <heading>" followed by the file's contents (already-formatted
#     markdown bullets, one per line). Emits NOTHING when the file is missing
#     or empty, so callers can call unconditionally for lists their flavour
#     may not produce.
#
# Every emitted section starts with a single blank line so calls compose
# directly after the intro line and after each other.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=src/scripts/defaults/platform.bash
source "${SCRIPT_DIR}/../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "${SCRIPT_DIR}/../lib/log.bash"
# shellcheck source=src/scripts/lib/docker-ref-expand.bash
source "${SCRIPT_DIR}/../lib/docker-ref-expand.bash"

usage_error() {
  log_error "$1"
  log_error "Usage: format-release-sections consume <project-name> <version> <registry> <namespace> [forms]"
  log_error "       format-release-sections list <heading> <list-file>"
  exit 1
}

# One reference, in its own fenced block. Label is omitted in the single-form
# modes, where there is no second entry to tell it apart from.
emit_reference() {
  local label="$1"
  local reference="$2"

  if [[ -n "${label}" ]]; then
    echo ""
    echo "**${label}**"
  fi
  echo ""
  echo '```'
  echo "${reference}"
  echo '```'
}

mode="${1:-}"

case "${mode}" in
  consume)
    [[ $# -eq 5 || $# -eq 6 ]] || usage_error "consume requires 4 or 5 arguments after the mode, got $(($# - 1))"
    project_name="$2"
    version="$3"
    registry="$4"
    namespace="$5"
    forms="${6:-}"
    [[ -n "${project_name}" ]] || usage_error "consume: project-name is required"
    [[ -n "${version}" ]] || usage_error "consume: version is required"
    [[ -n "${registry}" ]] || usage_error "consume: registry is required"

    # Empty means the project never declared consumerReferenceForms, so the
    # schema default applies. Kept here rather than in the mapping so the
    # default lives in exactly one place.
    forms="${forms:-short-only}"
    case "${forms}" in
      short-only|short-first|full-first|full-only) ;;
      *) usage_error "consume: unknown forms value '${forms}' - must be short-only, short-first, full-first or full-only" ;;
    esac

    # Expand through the resolver's own code so what we advertise is exactly
    # what a consumer's reference resolves to, prefix path segment included.
    # Namespace may legitimately be empty (registry-root images).
    DOCKER_TARGET_REGISTRY="${registry}"
    DOCKER_TARGET_NAMESPACE="${namespace}"
    docker_ref_expand "${project_name}:[${version}]" || exit 1

    short_reference="${project_name}:[${version}]"
    full_reference="${DOCKER_REF_FULL_NAME}:[${version}]"

    # Short form resolves against the consumer's own target pair.
    short_label="From any project using \`${registry}${namespace:+/${namespace}}\`"
    full_label="From any org, registry or platform"

    # Range example. The lower bound is this exact version because the bracket
    # is inclusive; the upper is the next major with the same part count, so
    # 1.0.7 -> [1.0.7,2.0.0), 2.4 -> [2.4,3.0), 5 -> [5,6).
    range_version="${version#v}"
    range_version="${range_version%%-*}"
    range_numeric=true
    IFS='.' read -ra range_parts <<< "${range_version}"
    for range_part in "${range_parts[@]}"; do
      [[ "${range_part}" =~ ^[0-9]+$ ]] || range_numeric=false
    done
    if [[ "${range_numeric}" == "true" ]]; then
      range_upper=$((range_parts[0] + 1))
      for ((range_index = 1; range_index < ${#range_parts[@]}; range_index++)); do
        range_upper="${range_upper}.0"
      done
      range_example="[${range_version},${range_upper})"
    else
      range_example="[1.0,2.0)"
    fi

    echo ""
    echo "### How to Consume"
    case "${forms}" in
      short-only) emit_reference "" "${short_reference}" ;;
      full-only)  emit_reference "" "${full_reference}" ;;
      short-first)
        emit_reference "${short_label}" "${short_reference}"
        emit_reference "${full_label}" "${full_reference}"
        ;;
      full-first)
        emit_reference "${full_label}" "${full_reference}"
        emit_reference "${short_label}" "${short_reference}"
        ;;
    esac
    echo ""
    echo "The brackets pin that exact version. A range such as \`${range_example}\` works in the same place but results in a slower and less secure build."
    ;;

  list)
    [[ $# -eq 3 ]] || usage_error "list requires exactly 2 arguments after the mode, got $(($# - 1))"
    heading="$2"
    list_file="$3"
    [[ -n "${heading}" ]] || usage_error "list: heading is required"

    # Missing or empty list -> emit nothing; callers invoke unconditionally.
    if [[ -n "${list_file}" && -s "${list_file}" ]]; then
      echo ""
      echo "### ${heading}"
      cat "${list_file}"
    fi
    ;;

  *)
    usage_error "Unknown mode: '${mode}'"
    ;;
esac
