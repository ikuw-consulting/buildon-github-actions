# stacked to substitute it. Later stages belong to kubernetes-run-substitute
# and kubernetes-run-finalise.
AGGREGATE_MANIFESTS_NORMALISED_DIR="${AGGREGATE_BASE}/manifests-aggregated"
AGGREGATE_MANIFESTS_PRUNED_DIR="${AGGREGATE_BASE}/manifests-pruned"
