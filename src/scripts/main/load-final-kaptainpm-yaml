  env_var="${mapping##*:}"

  # Extract value using yq (returns null for missing keys)
  value=$(yq -r ".${yaml_path}" "${PM_FILE}" )

  # Skip if value is empty, null, or an object/array marker
  if [[ -z "${value}" || "${value}" == "null" || "${value}" == "{}" || "${value}" == "[]" ]]; then
    continue
  fi

  # Suppress output_var stdout — the log line below provides better context
  output_var "${env_var}" "${value}" > /dev/null
  log "Field .${yaml_path} = \"${value}\" exported as ${env_var}"
  found_count=$((found_count + 1))
done
