#
# Load the final merged KaptainPM.yaml and export values as environment variables.
# Run from repo root after kaptain-init has written kaptainpm/final/KaptainPM.yaml.
# Uses output_var() to export via GITHUB_OUTPUT, REFERENCE_SCRIPT_OUTPUT, and direct export.
#
# Validates that the kind field matches the expected kind from the build wrapper
# before loading any fields.
#
# Inputs via env vars (required):
#   BUILD_KIND - The kind value from the build wrapper (exact kebab-case match)
set -euo pipefail

SCRIPT_DIR="$(dirname "${0}")"

# shellcheck source=src/scripts/defaults/platform.bash
source "${SCRIPT_DIR}/../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "${SCRIPT_DIR}/../lib/log.bash"

# shellcheck source=src/scripts/lib/output-var.bash
source "${SCRIPT_DIR}/../lib/output-var.bash"
# shellcheck source=src/scripts/defaults/docker-target.bash
source "${SCRIPT_DIR}/../defaults/docker-target.bash"
# shellcheck source=src/scripts/defaults/change-source.bash
source "${SCRIPT_DIR}/../defaults/change-source.bash"
# shellcheck source=src/scripts/defaults/output-sub-path.bash
source "${SCRIPT_DIR}/../defaults/output-sub-path.bash"
# shellcheck source=src/scripts/defaults/vendor-github-release.bash
source "${SCRIPT_DIR}/../defaults/vendor-github-release.bash"
# shellcheck source=src/scripts/defaults/tokens.bash
source "${SCRIPT_DIR}/../defaults/tokens.bash"
# shellcheck source=src/scripts/lib/kaptainpm-bool.bash
source "${SCRIPT_DIR}/../lib/kaptainpm-bool.bash"

# Build scripts repo root - absolute path to the buildon checkout this script
# is part of. Hooks need this so user hook scripts can locate the build's
# defaults/libs after exec replaces the calling launcher's context.
build_scripts_repo_root="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
output_var "BUILD_SCRIPTS_REPO_ROOT" "${build_scripts_repo_root}" > /dev/null
log "BUILD_SCRIPTS_REPO_ROOT = \"${build_scripts_repo_root}\""

PM_FILE="kaptainpm/final/KaptainPM.yaml"

if [[ ! -f "${PM_FILE}" ]]; then
  log_error "Project manifest not found: ${PM_FILE}"
  log_error "Has kaptain-init run? Expected final merged file at ${PM_FILE}"
  exit 1
fi

if ! command -v yq &> /dev/null; then
  log_error "yq is required but not installed"
  exit 1
fi

# Validate YAML syntax before reading
if ! yq eval '.' "${PM_FILE}" > /dev/null 2>&1; then
  log_error "Invalid YAML syntax in ${PM_FILE}"
  log "$(yq eval '.' "${PM_FILE}" 2>&1 | head -5)"
  exit 1
fi

# Kind validation - must match build wrapper's expected kind exactly
BUILD_KIND="${BUILD_KIND:?BUILD_KIND is required}"
log "Reading kind from ${PM_FILE}..."
log "$(yq -r '.kind // ""' "${PM_FILE}" 2>&1 || true)"
actual_kind=$(yq -r '.kind // ""' "${PM_FILE}")
if [[ -z "${actual_kind}" ]]; then
  log_error "KaptainPM.yaml does not declare a kind"
  exit 1
fi
if [[ "${actual_kind}" != "${BUILD_KIND}" ]]; then
  log_error "Kind mismatch: KaptainPM.yaml declares '${actual_kind}' but build wrapper expects '${BUILD_KIND}'"
  exit 1
fi
log "Kind matched: ${actual_kind}"

# --- Kaptain knob guards ---
# Both knobs are human-facing and never written by the pipeline or CI.
if [[ -n "${KAPTAIN_LOCAL_RELEASE:-}" ]]; then
  if [[ "${BUILD_MODE:-}" != "local" ]]; then
    log_error "KAPTAIN_LOCAL_RELEASE requires BUILD_MODE=local (it is the local-only release path; CI declares releases via its own channel)"
    exit 1
  fi
  if [[ -n "${KAPTAIN_BRANCH_OVERRIDE:-}" ]]; then
    log_error "KAPTAIN_LOCAL_RELEASE and KAPTAIN_BRANCH_OVERRIDE are mutually exclusive: the override bends policy for iteration, a release must enforce the real policy"
    exit 1
  fi
fi

